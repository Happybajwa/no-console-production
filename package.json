{
  "name": "no-console-production",
  "version": "3.1.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.prod.json",
    "test": "npm run test:comprehensive",
    "test:comprehensive": "tsx tests/run-all-tests.ts",
    "test:unit": "tsx tests/unit/console-suppression.test.ts && tsx tests/unit/environment.test.ts && tsx tests/unit/console-methods.test.ts",
    "test:integration": "tsx tests/integration/real-world-scenarios.test.ts",
    "test:all": "npm run test:comprehensive",
    "test:dev": "NODE_ENV=development npm run test:comprehensive",
    "test:prod": "NODE_ENV=production npm run test:comprehensive"
  },
  "keywords": [
    "console",
    "suppress",
    "React",
    "production",
    "logging",
    "typescript",
    "performance",
    "hooks",
    "lightweight"
  ],
  "author": "Harry",
  "license": "MIT",
  "description": "A lightweight, performant library to suppress console logs in production while preserving critical errors. Supports React hooks, components, and vanilla JavaScript.",
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "react": "^18.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Happybajwa/no-console-production.git"
  },
  "bugs": {
    "url": "https://github.com/Happybajwa/no-console-production/issues"
  },
  "homepage": "https://github.com/Happybajwa/no-console-production#readme"
}
